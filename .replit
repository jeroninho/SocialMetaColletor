modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
JWT_SECRET = "zG2NVJzvmmMw8xAbEhgMPu/2m/NYIEgTorz9ZhVYftWZhGvxHTw+65pWmJqSxmth"
TOKEN_SECRET = "0ec13726054c6f6b4afe856afded2b40aec3ac792e026fdb2dc01e48dfa85f49"
REDIS_URL = "redis://localhost:6379"
JWT_EXPIRES_IN = "1h"
CACHE_TTL_SECONDS = "60"

[nix]
channel = "stable-25_05"
